xGeometry as="geometry" x="693.0" y="229.0" width="214" height="122" /></mxCell><mxCell id="errors" value="Correct input errors&#10;Field-specific feedback&#10;Nothing recorded on failure" style="rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#452d21;strokeColor=#efb86e;fontColor=#eaf1ff;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="110.0" y="426.0" width="320" height="104" /></mxCell><mxCell id="ratios" value="02  Calculate financial ratios&#10;DSCR · LTV · debt yield&#10;Compare before display rounding" style="rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#242444;strokeColor=#aea0ff;fontColor=#eaf1ff;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="590.0" y="428.0" width="420" height="104" /></mxCell><mxCell id="evaluate" value="03  Evaluate all three rules&#10;Pass / review / decline per rule&#10;Decline &gt; review &gt; eligible" style="rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#242444;strokeColor=#aea0ff;fontColor=#eaf1ff;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="590.0" y="598.0" width="420" height="104" /></mxCell><mxCell id="save" value="04  Record evaluation evidence&#10;Inputs, ratios, reasons + outcome&#10;Policy snapshot, UUID + UTC time" style="rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#242444;strokeColor=#aea0ff;fontColor=#eaf1ff;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="590.0" y="764.0" width="420" height="112" /></mxCell><mxCell id="declineGate" value="Any decline?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#282c47;strokeColor=#9faed0;fontColor=#eaf1ff;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="693.0" y="949.0" width="214" height="122" /></mxCell><mxCell id="reviewGate" value="Any review?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#282c47;strokeColor=#9faed0;fontColor=#eaf1ff;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="693.0" y="1129.0" width="214" height="122" /></mxCell><mxCell id="allPass" value="All three rules pass&#10;No decline or review triggers" style="rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#173d38;strokeColor=#8ce8cc;fontColor=#eaf1ff;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="640.0" y="1330.0" width="320" height="100" /></mxCell><mxCell id="declineResult" value="SCREENING DECLINE&#10;Explain every triggered rule&#10;Outside fictional screening limits" style="rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#42253c;strokeColor=#f194c2;fontColor=#eaf1ff;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="1250.0" y="954.0" width="380" height="112" /></mxCell><mxCell id="reviewResult" value="ANALYST REVIEW&#10;Explain the rule exceptions&#10;Closer analyst review is needed" style="rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#40351f;strokeColor=#f4d28a;fontColor=#eaf1ff;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="1250.0" y="1134.0" width="380" height="112" /></mxCell><mxCell id="eligibleResult" value="ELIGIBLE FOR UNDERWRITING&#10;Explain the three passing rules&#10;Proceed to fictional underwriting" style="rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#173d38;strokeColor=#8ce8cc;fontColor=#eaf1ff;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="1250.0" y="1324.0" width="380" height="112" /></mxCell><mxCell id="inspect" value="05  Review / inspect / export&#10;Read the saved rule explanations&#10;Revisit history or download JSON" style="rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#132e38;strokeColor=#63e0d9;fontColor=#eaf1ff;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="100.0" y="1514.0" width="340" height="112" /></mxCell><mxCell id="edge0" value="Submit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeWidth=2;strokeColor=#929ebd;fontColor=#929ebd;fontSize=16;" edge="1" parent="1" source="intake" target="valid"><mxGeometry as="geometry" relative="1"><Array as="points" />